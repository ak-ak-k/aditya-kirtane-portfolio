{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ak-portfolio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets/"
              }
            ],
            "styles": ["src/assets/tokens/design-tokens.css", "src/styles.scss"]
          },
          "configurations": {
            "production": {
              "assets": [
                { "glob": "**/*", "input": "public", "ignore": ["favicon.ico"] },
                {
                  "glob": "{ak-logo-mark,favicon}.svg",
                  "input": "src/assets/branding",
                  "output": "/assets/branding/"
                },
                {
                  "glob": "portrait-headshot.webp",
                  "input": "src/assets/images/aditya",
                  "output": "/assets/images/aditya/"
                },
                {
                  "glob": "*.svg",
                  "ignore": ["home.svg"],
                  "input": "src/assets/icons/ui",
                  "output": "/assets/icons/ui/"
                },
                { "glob": "**/*", "input": "src/assets/projects", "output": "/assets/projects/" },
                {
                  "glob": "*",
                  "ignore": ["red-glow.svg"],
                  "input": "src/assets/textures",
                  "output": "/assets/textures/"
                },
                {
                  "glob": "section-dark.svg",
                  "input": "src/assets/backgrounds",
                  "output": "/assets/backgrounds/"
                },
                {
                  "glob": "aditya-kirtane-resume.pdf",
                  "input": "src/assets/resume",
                  "output": "/assets/resume/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "src/app/development/development.routes.ts",
                  "with": "src/app/development/development.routes.dev.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ak-portfolio:build:production"
            },
            "development": {
              "buildTarget": "ak-portfolio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
